# =============================================================================
# CryptoSentinel Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Confluent Cloud Configuration
# -----------------------------------------------------------------------------
# Get these from: https://confluent.cloud
# 1. Create a cluster (Basic tier is free)
# 2. Go to Cluster Settings > API Keys > Create Key
# 3. Go to Schema Registry > API credentials

KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-central1.gcp.confluent.cloud:9092
KAFKA_API_KEY=your-kafka-api-key
KAFKA_API_SECRET=your-kafka-api-secret

SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-central1.gcp.confluent.cloud
SCHEMA_REGISTRY_API_KEY=your-sr-api-key
SCHEMA_REGISTRY_API_SECRET=your-sr-api-secret

# -----------------------------------------------------------------------------
# Google AI Configuration
# -----------------------------------------------------------------------------
# Get Gemini API key from: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/minute, 1 million tokens/day

GEMINI_API_KEY=your-gemini-api-key

# Optional: For Vertex AI (not required for MVP)
# GCP_PROJECT_ID=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -----------------------------------------------------------------------------
# Reddit API Configuration
# -----------------------------------------------------------------------------
# Get these from: https://www.reddit.com/prefs/apps
# 1. Click "create another app..."
# 2. Select "script" type
# 3. client_id is the string under the app name
# 4. client_secret is labeled "secret"

REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=CryptoSentinel/1.0

# -----------------------------------------------------------------------------
# CoinGecko API Configuration
# -----------------------------------------------------------------------------
# Free tier works without API key (10-50 calls/minute)
# Optional: Get free key from https://www.coingecko.com/en/api

COINGECKO_API_KEY=

# -----------------------------------------------------------------------------
# News API Configuration (for sentiment analysis)
# -----------------------------------------------------------------------------
# NewsData.io: Free tier 200 requests/day, includes built-in sentiment
# Sign up at: https://newsdata.io (free)
NEWSDATA_API_KEY=

# GNews (backup): Free tier 100 requests/day
# Sign up at: https://gnews.io (free)
GNEWS_API_KEY=

# Note: Fear & Greed Index API (api.alternative.me) requires no API key!

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Coins to track (comma-separated)
TRACKED_COINS=bitcoin,ethereum,solana,dogecoin

# Subreddits to monitor (comma-separated)
TRACKED_SUBREDDITS=cryptocurrency,bitcoin,ethereum,solana,wallstreetbets

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit
STREAMLIT_PORT=8501

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Agent Configuration (Optional)
# -----------------------------------------------------------------------------
# Enable autonomous agent mode
AGENT_MODE=false

# MCP server URL for Confluent operations (leave empty to use Admin API)
MCP_SERVER_URL=

# Confluent Admin API URL (fallback if MCP not available)
CONFLUENT_ADMIN_API_URL=

# Maximum number of concurrent hypotheses
MAX_HYPOTHESES=10

# Maximum time per discovery cycle (seconds)
DISCOVERY_TIMEOUT=3600

